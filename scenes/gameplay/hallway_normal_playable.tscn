[node name="ForegroundVisibility" type="Node" parent="."]
script = ExtResource("7_visibility")
actor_sprite_path = NodePath("../Player/AnimatedSprite2D")
foreground_paths = Array[NodePath]([NodePath("../Hallway/Foreground/Pillar01"), NodePath("../Hallway/Foreground/Pillar02"), NodePath("../Hallway/Foreground/Pillar03")])

[node name="HallwayRealityPresenter" type="Node" parent="."]
script = ExtResource("9_presenter")
