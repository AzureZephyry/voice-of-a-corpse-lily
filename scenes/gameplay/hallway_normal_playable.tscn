[sub_resource type="RectangleShape2D" id="HallwayFeet"]
size = Vector2(24, 14)

[node name="HallwayNormalPlayable" type="Node2D"]
texture_filter = 1
y_sort_enabled = true
process_physics_priority = 20
script = ExtResource("4_host")
editor_description = "Standalone Hallway test (F6). Debug R switches reality; M toggles reduced motion. Spawn (480,610) is development-only. No story entrance or exit."

[node name="Hallway" parent="." instance=ExtResource("1_room")]

[node name="Player" parent="." instance=ExtResource("2_player")]
position = Vector2(480, 610)
script = ExtResource("3_movement")

[node name="AnimatedSprite2D" parent="Player" index="0"]
scale = Vector2(5, 5)
animation = &"idle_right"
autoplay = "idle_right"

[node name="CollisionShape2D" parent="Player" index="1"]
position = Vector2(0, -7)
shape = SubResource("HallwayFeet")

[node name="FootstepAudio" parent="Player" instance=ExtResource("5_footsteps")]
default_surface = "interior"

[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(640, 480)
limit_left = 0
limit_top = 0
limit_right = 3842
limit_bottom = 960
position_smoothing_enabled = false
editor_description = "Horizontal follow after Player physics. Fixed y480; whole-pixel position; 1x zoom."

[node name="TimeHUD" parent="." instance=ExtResource("6_clock_hud")]
